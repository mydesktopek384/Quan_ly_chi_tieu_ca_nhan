<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:fitsSystemWindows="true"
    android:layout_height="60dp"
    android:background="#FFFFFF"
    android:gravity="center"
    android:orientation="horizontal">

    <TextView
        android:id="@+id/navTrangChu"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:gravity="center"
        android:text="H\nTrang chủ"
        android:textColor="#64748B"
        android:textSize="11sp" />

    <TextView
        android:id="@+id/navGiaoDich"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:gravity="center"
        android:text="G\nGiao dịch"
        android:textColor="#64748B"
        android:textSize="11sp" />

    <TextView
        android:id="@+id/navThemMoi"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:gravity="center"
        android:text="+\nThêm mới"
        android:textColor="#64748B"
        android:textSize="11sp" />

    <TextView
        android:id="@+id/navThongKe"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:gravity="center"
        android:text="T\nThống kê"
        android:textColor="#2563EB"
        android:textSize="11sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/navCaNhan"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:gravity="center"
        android:text="C\nCá nhân"
        android:textColor="#64748B"
        android:textSize="11sp" />
</LinearLayout>
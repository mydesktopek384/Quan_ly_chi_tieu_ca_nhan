<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    android:background="#F1F5F9"
    android:orientation="vertical">

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#FFFFFF"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="14dp">

        <TextView
            android:id="@+id/btnBackGiaoDich"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingEnd="12dp"
            android:text="‹"
            android:textColor="#1E293B"
            android:textSize="28sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Quản lý giao dịch"
            android:textColor="#1E293B"
            android:textSize="20sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnDiDenThongKe"
            android:layout_width="wrap_content"
            android:layout_height="38dp"
            android:backgroundTint="#DBEAFE"
            android:text="Thống kê →"
            android:textAllCaps="false"
            android:textColor="#2563EB"
            android:textSize="12sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Khu vực Form Nhập liệu (Thêm / Sửa) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="10dp"
        android:background="#FFFFFF"
        android:orientation="vertical"
        android:padding="12dp">

        <!-- Dòng 1: Chọn Loại Thu / Chi -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Loại: "
                android:textColor="#1E293B"
                android:textStyle="bold" />

            <RadioGroup
                android:id="@+id/rgLoaiGD"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <RadioButton
                    android:id="@+id/radChi"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:checked="true"
                    android:text="Khoản Chi"
                    android:textColor="#EF4444" />

                <RadioButton
                    android:id="@+id/radThu"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:layout_marginStart="12dp"
                    android:text="Khoản Thu"
                    android:textColor="#16A34A" />
            </RadioGroup>
        </LinearLayout>

        <!-- Dòng 2: Tên giao dịch & Số tiền -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:orientation="horizontal">

            <EditText
                android:id="@+id/edtTenGD"
                android:layout_width="0dp"
                android:layout_height="42dp"
                android:layout_weight="1.2"
                android:hint="Tên giao dịch (VD: Ăn sáng)"
                android:inputType="text"
                android:textColor="#000000"
                android:textColorHint="#64748B"
                android:textSize="14sp" />

            <EditText
                android:id="@+id/edtSoTienGD"
                android:layout_width="0dp"
                android:layout_height="42dp"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:hint="Số tiền (VNĐ)"
                android:inputType="number"
                android:textColor="#000000"
                android:textColorHint="#64748B"
                android:textSize="14sp" />
        </LinearLayout>

        <!-- Dòng 3: Spinner Danh mục & Spinner Tháng -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:orientation="horizontal">

            <Spinner
                android:id="@+id/spDanhMucGD"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_weight="1"
                android:background="#FFFFFF" />

            <Spinner
                android:id="@+id/spThangGD"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:background="#FFFFFF" />
        </LinearLayout>

        <!-- Dòng 4: Ngày giao dịch & CheckBox xác nhận -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <EditText
                android:id="@+id/edtNgayGD"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_weight="1"
                android:hint="Ngày (dd/MM/yyyy)"
                android:text="25/11/2026"
                android:textColor="#000000"
                android:background="#FFFFFF"
                android:textSize="13sp" />

            <CheckBox
                android:id="@+id/cbXacNhanGD"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:checked="true"
                android:text="Tính vào thống kê"
                android:textColorHint="#000000"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- Dòng 5: 4 Nút chức năng Thêm - Sửa - Xóa - Làm mới -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnThemGD"
                android:layout_width="0dp"
                android:layout_height="42dp"
                android:layout_weight="1"
                android:backgroundTint="#2563EB"
                android:text="Thêm"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textSize="13sp" />

            <Button
                android:id="@+id/btnSuaGD"
                android:layout_width="0dp"
                android:layout_height="42dp"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:backgroundTint="#16A34A"
                android:text="Sửa"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textSize="13sp" />

            <Button
                android:id="@+id/btnXoaGD"
                android:layout_width="0dp"
                android:layout_height="42dp"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:backgroundTint="#EF4444"
                android:text="Xóa"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textSize="13sp" />

            <Button
                android:id="@+id/btnLamMoiGD"
                android:layout_width="0dp"
                android:layout_height="42dp"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:backgroundTint="#64748B"
                android:text="Mới"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textSize="13sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- Khu vực Tìm kiếm & Phân loại -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="10dp"
        android:layout_marginBottom="8dp"
        android:background="#FFFFFF"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="8dp">

        <EditText
            android:id="@+id/edtTimKiemGD"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1.3"
            android:hint="Tìm tên giao dịch..."
            android:inputType="text"
            android:textColor="#000000"
            android:textColorHint="#D9D9D9"
            android:textSize="13sp" />

        <Spinner
            android:id="@+id/spLocLoaiGD"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:background="#FFFDFD" />
    </LinearLayout>

    <!-- Danh sách giao dịch (Custom ListView) -->
    <ListView
        android:id="@+id/lvGiaoDich"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginHorizontal="10dp"
        android:layout_weight="1"
        android:divider="#F1F5F9"
        android:dividerHeight="6dp" />

    <include layout="@layout/layout_bottom_nav_thongke" />
</LinearLayout>